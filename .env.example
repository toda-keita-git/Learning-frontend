# このファイルをコピーして .env を作成し、各自の値を設定してください。
# .env は .gitignore 済みなので、実際の値は公開されません。

# GitHub OAuth App の Client ID
VITE_GITHUB_CLIENT_ID="your_github_oauth_client_id"

# OAuth コールバックURL（OAuth App の設定と一致させる）
VITE_CALLBACK_URL="http://localhost:5173/LearningContent"

# Google OAuth クライアントID（Googleドライブ連携用）
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id"

# GoogleのOAuthコールバックURL（Google Cloud Consoleの「承認済みのリダイレクトURI」と一致させる）
VITE_GOOGLE_CALLBACK_URL="http://localhost:5173/google/callback"

# Google Picker API用のAPIキー（OAuthクライアントID/シークレットとは別物）。
# メモ添付で「Googleドライブから選ぶ」を使うために必要。Google Cloud Consoleで
# 「Google Picker API」を有効化し、HTTPリファラーを許可ドメインに制限したAPIキーを作成する
VITE_GOOGLE_PICKER_API_KEY="your_google_picker_api_key"

# 学習データを保存する対象リポジトリ
VITE_REPO_OWNER="your_github_username"
VITE_REPO_NAME="Learning_Data"

# バックエンドのベースURL（OAuthコードをトークンに交換するのに使う）。
# 末尾に /github などのパスは付けないこと。コード側で
# `${VITE_BACKEND_TOKEN_URL}/github/callback` `${VITE_BACKEND_TOKEN_URL}/google/callback`
# のようにパスを組み立てるため、付けると存在しないURLになる
VITE_BACKEND_TOKEN_URL="http://127.0.0.1:8080"

# バックエンドのベースURL（本番ビルドでの学習記録・カテゴリ・タグ等のAPI呼び出し先。
# 開発時はvite.config.tsのプロキシを使うため未設定でも動作する）
VITE_API_BASE_URL="http://127.0.0.1:8080"

# Google AdSense（ゲストモード・フリープラン向けの広告表示に使用。
# 審査通過後に発行される値を設定する。未設定の間は広告枠自体が表示されない）
VITE_ADSENSE_CLIENT_ID="ca-pub-xxxxxxxxxxxxxxxx"
VITE_ADSENSE_AD_SLOT="xxxxxxxxxx"
